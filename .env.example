# ─────────────────────────────────────────────────────────────────────────────
# Bizim Event — environment variables
# Copy to .env.local for local dev. On Vercel, add them in Project → Settings →
# Environment Variables (Neon's are added automatically by the integration).
# Everything except DATABASE_URL and BETTER_AUTH_SECRET is optional: missing
# providers fall back to safe stubs (emails log to the console, address search
# uses OpenStreetMap, uploads go to .dev-uploads/ in development only, chat
# polls, SMS is off).
# ─────────────────────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Neon Postgres — Vercel Marketplace → Neon (free plan). Sets these automatically.
# Pooled connection for the app:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bizim_dev
# Direct connection for migrations (drizzle-kit / pnpm db:migrate):
DATABASE_URL_UNPOOLED=

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Google OAuth — console.cloud.google.com → APIs & Services → Credentials
# Authorised redirect URI: <APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend — resend.com → API Keys (verify your domain: SPF + DKIM)
RESEND_API_KEY=
EMAIL_FROM="Bizim Event <hello@bizimevent.co.uk>"

# Cloudflare R2 — dash.cloudflare.com → R2 → Manage API tokens (S3 access key)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=bizim-event
# Public bucket URL or custom domain, e.g. https://media.bizimevent.co.uk
R2_PUBLIC_URL=
# Extra origins allowed to upload (comma separated), applied by `pnpm r2:cors`
R2_CORS_ORIGINS=

# Pusher Channels — dashboard.pusher.com → Channels → create app (free sandbox, cluster eu)
PUSHER_APP_ID=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=eu

# Upstash Redis — console.upstash.com → Redis → create database (free) → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Stripe Billing — dashboard.stripe.com → Developers → API keys / Webhooks
# Product "Bizim Event Business" with two GBP prices: £6/month and £60/year
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TAX_ENABLED=false

# Google Places — console.cloud.google.com → Places API (New); restrict the key to your domain.
# Optional: without it, address search uses Photon (OpenStreetMap, no key).
GOOGLE_PLACES_API_KEY=
NEXT_PUBLIC_GOOGLE_PLACES_KEY=

# Unsplash — unsplash.com/developers (free; apply for production once live)
UNSPLASH_ACCESS_KEY=

# Cloudflare Turnstile — dash.cloudflare.com → Turnstile (free)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# SMS via Infobip — PAID per message, leave off until needed
SMS_ENABLED=false
INFOBIP_BASE_URL=
INFOBIP_API_KEY=
INFOBIP_SENDER=BizimEvent

# "Translate with AI" in the listing editor (optional)
# Set TRANSLATE_PROVIDER=anthropic and an API key from console.anthropic.com to show the button.
TRANSLATE_PROVIDER=none
ANTHROPIC_API_KEY=
TRANSLATE_MODEL=claude-haiku-5-5

# Vercel Cron — any long random string; Vercel sends it as a Bearer token
CRON_SECRET=

# Sentry (optional, free tier)
SENTRY_DSN=

# Tests only: a Postgres with PostGIS (CI uses the postgis/postgis service)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/bizim_test
